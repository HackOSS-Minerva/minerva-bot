# Bot Configuration
BOT_USERNAME=minerva-bot

# Discord
# Required
DISCORD_BOT_TOKEN=
# Application public key.
DISCORD_PUBLIC_KEY=
# Discord application ID.
DISCORD_APPLICATION_ID=
# Optional
# Comma-separated role IDs that should trigger mention handlers.
DISCORD_MENTION_ROLE_IDS=
# Comma-separated parent channel IDs whose non-bot messages trigger mention handlers without an @mention.
DISCORD_RESPOND_TO_CHANNEL_IDS=
# Override the Discord API base URL.
DISCORD_API_URL=

# Discord Gateway (serverless cron)
# Secret used to authenticate Vercel cron requests to the Gateway route.
CRON_SECRET=

# Memory
# No environment variables are required. State is kept in the current process.
